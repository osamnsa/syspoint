APP_NAME="Syspoint"
APP_URL=http://localhost:8000
APP_BASE_PATH=

DB_HOST=127.0.0.1
DB_NAME=syspoint
DB_USER=root
DB_PASS=

# Paystack (test keys from https://dashboard.paystack.com/#/settings/developers)
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# Outbound mail (order confirmations, booking confirmations, etc.)
MAIL_FROM=orders@syspoint.example
MAIL_FROM_NAME="Syspoint"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Telegram bot notifications to the admin (new order, new booking, new
# software request, new contact message) — optional, everything works
# without it, admin just relies on the in-panel inboxes instead.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=

# Protects the cron-hit endpoints (none needed yet, reserved for later —
# same shared-secret pattern as everything else on shared hosting with no
# queue/worker).
CRON_SECRET=

# The app is index.php — never a leftover index.html from an older site.
DirectoryIndex index.php

<IfModule mod_rewrite.c>
    RewriteEngine On

    # The homepage always goes to the app, even if an old index.html or
    # index.htm is still sitting in this folder from a previous upload.
    RewriteRule ^(index\.html?)?$ index.php [L]

    # Serve real files/directories (assets, uploads) directly.
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Everything else goes through the front controller.
    RewriteRule ^ index.php [L]
</IfModule>

<FilesMatch "^\.">
    Require all denied
</FilesMatch>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/webp "access plus 1 month"
</IfModule>
